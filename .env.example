# Copy this file to .env and fill in the values. .env is never committed.

# Postgres container (docker-compose.yml)
POSTGRES_USER=overlook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=overlook
POSTGRES_PORT=5433

# Backend connection string (must match the values above)
DATABASE_URL=postgresql://overlook:change-me@localhost:5433/overlook

# API keys: put your REAL keys only in .env, never in this file (it is committed to GitHub).
ANTHROPIC_API_KEY=your-anthropic-key-here
VOYAGE_API_KEY=your-voyage-key-here

# Backend API (step 15): website addresses allowed to call the API from a browser (comma-separated).
# Default if absent: the frontend's local dev server.
CORS_ORIGINS=http://localhost:5173
